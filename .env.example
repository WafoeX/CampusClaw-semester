# Copy to .env and generate values locally. Blank values are intentionally unusable.
APP_ENV=demo
DATABASE_URL=
POSTGRES_DB=campusclaw
POSTGRES_USER=campusclaw
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=28800
UPLOAD_ROOT=/var/lib/campusclaw/materials
UPLOAD_MAX_BYTES=52428800
SEED_DEMO_DATA=true
DEMO_ALPHA_TEACHER_PASSWORD=
DEMO_ALPHA_STUDENT_PASSWORD=
DEMO_BETA_TEACHER_PASSWORD=
DEMO_BETA_STUDENT_PASSWORD=
WEB_PORT=8080
# MCP secrets are injected at runtime into API and mcp-demo only.
MCP_AUTH_TOKEN=
MCP_APPROVED_SERVERS={"http://mcp-demo:8090":"MCP_AUTH_TOKEN"}
# Retrieval/model settings are server-only; never place these in frontend inputs.
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_DATA_BOUNDARY=private
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
GENERATION_ENDPOINT=
GENERATION_API_KEY=
GENERATION_DATA_BOUNDARY=private
GENERATION_MODEL=grounded-answer
GENERATION_TEMPERATURE=0
GENERATION_TIMEOUT_SECONDS=30
GENERATION_MAX_RETRIES=1
GENERATION_MAX_OUTPUT_TOKENS=256
GENERATION_EVIDENCE_CHAR_BUDGET=6000
GENERATION_STRUCTURED_OUTPUT=true
EXTRACTION_CHUNK_CHARS=800
EXTRACTION_CHUNK_OVERLAP=120
QUERY_DEFAULT_RESULT_LIMIT=6
QUERY_MAX_RESULT_LIMIT=12
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=campusclaw-knowledge-v1
QDRANT_DISTANCE=Cosine
# Creator-owned configuration; all limits are enforced on the server.
AGENT_NAME_MAX_CHARS=120
AGENT_DESCRIPTION_MAX_CHARS=1000
AGENT_PROMPT_MAX_CHARS=12000
SKILL_NAME_MAX_CHARS=120
SKILL_INSTRUCTIONS_MAX_CHARS=12000
CONVERSATION_MESSAGE_MAX_CHARS=8000
CONVERSATION_HISTORY_MAX_MESSAGES=20
CONVERSATION_HISTORY_MAX_CHARS=24000
# heartbeat < task timeout <= 300; Nginx proxy_read_timeout is 330s.
SSE_HEARTBEAT_SECONDS=15
SSE_TASK_TIMEOUT_SECONDS=90
CONVERSATION_RATE_LIMIT_PER_MINUTE=30
