{
  "venvPath": "api",
  "venv": ".venv",
  "include": ["api/src", "api/tests", "apitest"],
  "extraPaths": [".", "api/src"],
  "pythonVersion": "3.12",
  "typeCheckingMode": "strict",
  "executionEnvironments": [
    {
      "root": "api",
      "extraPaths": ["api/src"]
    },
    {
      "root": "apitest",
      "extraPaths": [".", "api/src"]
    }
  ]
}
